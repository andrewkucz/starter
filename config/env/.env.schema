# Env config for the web app (TanStack Start).
#
# Where values come from:
# - Secrets: `infisical()` from the Infisical project (`prod` in production). The process
#   authenticates with the machine identity below.
# - development: `.env.development` (local docker services from config/dev.compose.yml)
# - production: `.env.production` (docker-compose.yml service topology)
# - test: `.env.test` (dummy values for every secret, so Infisical is never called)
# Personal overrides go in gitignored `.env.local` / `.env.development.local` in this folder.
#
# Nothing is inlined into bundles at build time (`@defaultDynamic=true`) except `@static` items;
# everything else is read server-side via `ENV` from `varlock/env`. Only `VITE_*` items are public
# (`@defaultSensitive=inferFromPrefix('VITE_')`).
#
# Production images never resolve config themselves: the Docker build resolves it once and encrypts
# it with _VARLOCK_ENV_KEY (into the SSR build for `web`, and a `varlock freeze` file for `migrate`).
#
# @currentEnv=$APP_ENV
# @defaultRequired=infer @defaultDynamic=true @defaultSensitive=inferFromPrefix('VITE_')
# @encryptInjectedEnv=forEnv(production)
# @generateTsTypes(path=../../src/env.d.ts, auto=true)
# @plugin(@varlock/infisical-plugin)
# @initInfisical(
#   projectId=$INFISICAL_PROJECT_ID,
#   environment=if(forEnv(production), prod, dev),
#   clientId=$INFISICAL_CLIENT_ID,
#   clientSecret=$INFISICAL_CLIENT_SECRET
# )
# ---

# Detected from the runtime (vitest => test, local => development); docker-compose.yml sets production.
# @type=enum(development, preview, staging, production, test)
APP_ENV=$VARLOCK_ENV

# package.json `version`, shown in the UI. Release tags are cut from package.json by `bumpp`, so it
# matches the latest tag (and `.git` is not available inside the Docker build).
# @type=semver @static
VITE_APP_VERSION=exec(`node -p "require('./package.json').version"`)

# --- Infisical machine identity (Universal Auth) ---
# Production: only needed while building the images (the `build_env` secret in docker-compose.yml).
# Development: optional; set them in your gitignored config/env/.env.local to pull secrets from Infisical
# `dev` instead of the local values in `.env.development`.
# @docs(https://infisical.com/docs/documentation/platform/identities/universal-auth)
# @required=forEnv(production)
INFISICAL_PROJECT_ID=
# @type=infisicalClientId @sensitive @required=forEnv(production)
INFISICAL_CLIENT_ID=
# @type=infisicalClientSecret @sensitive @internal @required=forEnv(production)
INFISICAL_CLIENT_SECRET=

# --- Database ---

# @type=url(allowedProtocols=[postgres, postgresql]) @sensitive @required
DATABASE_URL=

# Password for the production Postgres container, supplied by the deploy environment
# and used to build DATABASE_URL in .env.production.
# @sensitive @required=forEnv(production)
POSTGRES_PASSWORD=

# --- Auth ---

# Public app origin used by Better Auth.
# @type=url @required
BETTER_AUTH_URL=
# @sensitive @required
BETTER_AUTH_SECRET=infisical()

# Comma-separated list of emails that are granted the admin role.
# @example="admin@example.com,other@example.com"
ADMIN_EMAILS=

# Optional Discord sign-in; enabled when both values are set.
DISCORD_CLIENT_ID=
# @sensitive
DISCORD_CLIENT_SECRET=
