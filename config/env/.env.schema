# Personal overrides go in gitignored `.env.local` / `.env.development.local` in this folder.
#
# @currentEnv=$APP_ENV
# @defaultRequired=infer @defaultDynamic=true @defaultSensitive=inferFromPrefix('VITE_')
# @encryptInjectedEnv=forEnv(production)
# @generateTsTypes(path=../../src/env.d.ts, auto=true)
# @plugin(@varlock/infisical-plugin)
# @initInfisical(
#   projectId=$INFISICAL_PROJECT_ID,
#   environment=if(forEnv(production), prod, dev),
#   clientId=$INFISICAL_CLIENT_ID,
#   clientSecret=$INFISICAL_CLIENT_SECRET
# )
# ---

# @type=enum(development, preview, staging, production, test) @sensitive=false
APP_ENV=$VARLOCK_ENV

# Read from package.json because `.git` is not available inside the Docker build.
# @type=semver @static
VITE_APP_VERSION=exec(`node -p "require('./package.json').version"`)

# --- Infisical machine identity (Universal Auth) ---
# Production: only needed during the image build. Development: optional; set in `.env.local` to
# pull secrets from Infisical `dev` instead of `.env.development`.
# @docs(https://infisical.com/docs/documentation/platform/identities/universal-auth)
# @required=forEnv(production)
INFISICAL_PROJECT_ID=
# @type=infisicalClientId @sensitive @required=forEnv(production)
INFISICAL_CLIENT_ID=
# @type=infisicalClientSecret @sensitive @internal @required=forEnv(production)
INFISICAL_CLIENT_SECRET=

# --- Database ---

# @type=url(allowedProtocols=[postgres, postgresql]) @sensitive @required
DATABASE_URL=

# @sensitive @required=forEnv(production)
POSTGRES_PASSWORD=

# --- Auth ---

# @type=url @required
BETTER_AUTH_URL=
# @sensitive @required
BETTER_AUTH_SECRET=infisical()

# @example="admin@example.com,other@example.com"
ADMIN_EMAILS=

# Discord sign-in is enabled when both values are set.
# @required=false
DISCORD_CLIENT_ID=if($INFISICAL_PROJECT_ID, infisical(allowMissing=true))
# @sensitive @required=false
DISCORD_CLIENT_SECRET=if($INFISICAL_PROJECT_ID, infisical(allowMissing=true))
