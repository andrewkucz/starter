{
  "name": "starter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "run-script": "varlock run -- tsx",
    "generate-routes": "tsr generate",
    "build": "vp build",
    "start": "varlock run -- node .output/server/index.mjs",
    "preview": "vp preview",
    "services:up": "scripts/local-services.sh",
    "db:generate": "drizzle-kit generate --config config/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config config/drizzle.config.ts",
    "gen:auth": "APP_ENV=test auth generate --config src/lib/auth/server-client.ts --output ./src/db/auth.schema.ts --yes",
    "prepare": "vp config",
    "env:check": "varlock load",
    "release": "bumpp"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@better-auth-ui/core": "^1.6.18",
    "@better-auth-ui/react": "^1.6.18",
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@lukemorales/query-key-factory": "^1.3.4",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/match-sorter-utils": "9.1.2",
    "@tanstack/react-devtools": "0.10.12",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-query-devtools": "5.101.4",
    "@tanstack/react-query-persist-client": "5.101.4",
    "@tanstack/react-router": "1.170.31",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.48",
    "@tanstack/react-table": "9.1.2",
    "@varlock/infisical-plugin": "^2.1.2",
    "better-auth": "^1.7.2",
    "bowser": "^2.14.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "1.0.0-rc.4",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.33.0",
    "nitro": "3.0.260903-beta",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "srvx": "^0.12.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "varlock": "^1.21.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "^1.132.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@varlock/vite-integration": "^1.5.2",
    "@vitejs/plugin-react": "^6.0.1",
    "auth": "^1.7.2",
    "bumpp": "^12.3.0",
    "drizzle-kit": "1.0.0-rc.4",
    "happy-dom": "^20.14.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  },
  "intent": {
    "skills": [
      "@tanstack/*",
      "dotenv",
      "drizzle-kit"
    ]
